        },
        {
          "path": "contributions/power-key-single-press/attachments/tb-power-key-off",
          "sha256": "8d164edae75fd2f3da65a612bc0af62d9cc3723932162b5006b101cdec2df6f3"
        },
        {
          "path": "contributions/power-key-single-press/attachments/tb-gnome-power-button.service",
          "sha256": "23633ede944d1f35c1c015bf548e4e12414d77ea3640b06a39b29417c04232af"
