#!/bin/sh
set -eu
log=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/droidloom-launch.XXXXXX")
trap 'rm -f "$log"' EXIT HUP INT TERM
if ! (
  flock -x 9
  if ! /usr/bin/droidloomctl --json status 2>/dev/null | /usr/bin/python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("state") == "running" else 1)' 2>/dev/null; then
    command -v notify-send >/dev/null && notify-send "安卓容器" "正在启动，请稍候…" || true
    /usr/bin/droidloomctl start
  fi
) 9>"${XDG_RUNTIME_DIR:-/tmp}/droidloom-on-demand.lock" >"$log" 2>&1; then
  /usr/bin/zenity --error --title="安卓容器启动失败" --text="$(cat "$log")" 2>/dev/null || true
  exit 1
fi
if ! /usr/bin/droidloomctl launch "$@" >"$log" 2>&1; then
  /usr/bin/zenity --error --title="安卓应用启动失败" --text="$(cat "$log")" 2>/dev/null || true
  exit 1
fi
