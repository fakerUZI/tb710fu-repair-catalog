 static void nvt_fw_health_work(struct work_struct *work)
 {
 	bool repaired = false;
+#if NVT_SUPPORT_PEN
+	bool restore_pen = false;
+#endif
+
 	if (!READ_ONCE(nvt_health_ready) ||
