[Unit]
Description=TB710FU magnetic keyboard posture (%i)
BindsTo=dev-input-%i.device
After=dev-input-%i.device

[Service]
ExecStart=/usr/bin/python3 -I /usr/local/libexec/tb710fu-pogo-fold-reader.py %i
RuntimeDirectory=tb710fu-pogo-fold-%i
RuntimeDirectoryMode=0755
DevicePolicy=closed
DeviceAllow=/dev/input/%i r
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
Restart=on-failure
RestartSec=1
