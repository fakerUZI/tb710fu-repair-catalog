[Unit]
Description=Recover the TB710FU display after GNOME login and 60 Hz unlock
PartOf=graphical-session.target
After=graphical-session-pre.target

[Service]
Type=exec
ExecStart=/usr/bin/python3 -I %h/.local/libexec/tb710fu-login-display.py
TimeoutStopSec=12

[Install]
WantedBy=graphical-session.target
