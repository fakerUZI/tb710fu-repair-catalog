LOCK_PATH = os.path.join(CACHE_DIR, "grip.lock")
MAX_LOG = 1 << 20

XI_TOUCH_BEGIN = 18
XI_TOUCH_UPDATE = 19
XI_TOUCH_END = 20

XI_TOUCH_CLASS = 8
XI_SLAVE_POINTER = 3
GENERIC_EVENT = 35
IS_VIEWABLE = 2
XI_ANY_MODIFIER = -2147483648
XIAcceptTouch = 6
XIRejectTouch = 7
XA_ATOM = 4

DEFAULTS = {
    "strip": 80,        # 顶部标题栏条高度（物理像素）；0 = 不拖动
    "edge": 18,         # 边缘缩放带宽度（物理像素）；0 = 不按边缘缩放
    "corner": 54,       # 角落缩放方块边长（物理像素）
    "slop": 14,         # 超过多少像素才算拖动/缩放
    "tap": "reject",    # reject = 交还应用 | none = 什么都不做
    "min_width": 400,   # 只抓取宽度不小于此值的窗口
    "min_height": 200,
    "resize": True,
}

DEFAULT_CONFIG = {
    "defaults": dict(DEFAULTS),
    "targets": [
        {"name": "workbuddy", "match": ["workbuddy"], "strip": 80},
    ],
}


def log(msg):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        if os.path.exists(LOG_PATH) and os.path.getsize(LOG_PATH) > MAX_LOG:
            os.replace(LOG_PATH, LOG_PATH + ".1")
        with open(LOG_PATH, "a", encoding="utf-8") as fh:
            fh.write(time.strftime("%m-%d %H:%M:%S ") + msg + "\n")
    except Exception:
        pass


# ---------------------------------------------------------------- 配置
def load_config():
    cfg = None
    try:
        with open(CONFIG_PATH, encoding="utf-8") as fh:
            cfg = json.load(fh)
    except FileNotFoundError:
        cfg = json.loads(json.dumps(DEFAULT_CONFIG))
        save_config(cfg)
    except Exception as exc:
        log("config read error: %r" % (exc,))
        cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    cfg.setdefault("defaults", {})
    cfg.setdefault("targets", [])
    merged_defaults = dict(DEFAULTS)
    merged_defaults.update({k: v for k, v in cfg["defaults"].items() if k in DEFAULTS})
    cfg["defaults"] = merged_defaults
    targets = []
    for t in cfg["targets"]:
        if not t.get("match"):
            continue
        prof = dict(merged_defaults)
        prof.update({k: v for k, v in t.items() if k in DEFAULTS})
        prof["name"] = t.get("name") or t["match"][0]
        prof["match"] = [str(m).lower() for m in t["match"]]
        targets.append(prof)
    cfg["resolved"] = targets
    return cfg


def save_config(cfg):
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        out = {"defaults": cfg.get("defaults", dict(DEFAULTS)),
               "targets": cfg.get("targets", [])}
        tmp = CONFIG_PATH + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(out, fh, ensure_ascii=False, indent=2)
            fh.write("\n")
        os.replace(tmp, CONFIG_PATH)
        return True
    except Exception as exc:
        log("config write error: %r" % (exc,))
        return False


def env_overrides(cfg):
    """临时覆盖（TWG_* 优先，兼容旧的 WBM_*）。逐项生效，不要求全给。"""
    def pick(name, kind):
        for prefix in ("TWG_", "WBM_"):
            raw = os.environ.get(prefix + name)
            if raw not in (None, ""):
                try:
                    return kind(raw)
                except ValueError:
                    continue
        return None

    vals = {}
    for name, kind in (("strip", float), ("edge", float), ("corner", float),
                       ("slop", float)):
        v = pick(name.upper(), kind)
        if v is not None:
            vals[name] = v
    tap = pick("TAP", str)
    if tap:
        vals["tap"] = tap.strip().lower()
    match = pick("MATCH", str)
    if match:
        vals["match"] = [m.strip().lower() for m in match.split(",") if m.strip()]
    if vals:
        for prof in cfg["resolved"]:
            prof.update(vals)
    return cfg


