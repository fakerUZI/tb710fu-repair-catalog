[Unit]
Description=TB710FU local password-prompt face verification
After=systemd-logind.service

[Service]
ExecStart=/usr/bin/python3 -I /usr/local/lib/tb710fu-face-unlock/system-password.py serve
Restart=on-failure
RuntimeDirectory=tb710fu-face-password
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tb710fu-face-unlock
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
