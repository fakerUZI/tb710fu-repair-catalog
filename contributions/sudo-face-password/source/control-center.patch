 static void
+on_password_mode_changed (AdwComboRow *row, GParamSpec *pspec, CcScreenPage *self)
+{
+  guint index = adw_combo_row_get_selected (row);
+  if (index < G_N_ELEMENTS (password_modes) - 1)
+    run_face_action (self, password_modes[index]);
+}
+
+static void
+add_password_mode (CcScreenPage *self)
+{
+  const char *labels[] = {
+    face_text ("Off", "关闭"), face_text ("Until screen lock", "仅解锁后"),
+    face_text ("Until restart", "仅开机"), face_text ("Always", "始终"), NULL
+  };
+  g_autoptr (GtkStringList) model = gtk_string_list_new (labels);
+
+  if (!g_file_test (FACE_PASSWORD_ADMIN, G_FILE_TEST_IS_EXECUTABLE))
+    return;
+  self->face_password_row = ADW_COMBO_ROW (adw_combo_row_new ());
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (self->face_password_row),
+                                 face_text ("Face recognition for system passwords", "用人脸识别验证系统密码"));
+  adw_action_row_set_subtitle (ADW_ACTION_ROW (self->face_password_row),
+    face_text ("Choose face recognition at the first prompt. Each following request scans your face again.",
+               "首次授权时选择人脸或密码。选用人脸后，在所选时段内每次授权都会重新识别。"));
+  adw_combo_row_set_model (self->face_password_row, G_LIST_MODEL (model));
+  self->face_password_changed = g_signal_connect (self->face_password_row, "notify::selected",
+                                                  G_CALLBACK (on_password_mode_changed), self);
+  adw_preferences_group_add (self->face_unlock_group, GTK_WIDGET (self->face_password_row));
+}
