+#define FACE_PASSWORD_ADMIN "/usr/local/lib/tb710fu-face-unlock/configure"
+static const char *const password_modes[] = { "off", "unlock", "boot", "always", NULL };
+
+static void
+refresh_password_mode (CcScreenPage *self)
+{
+  g_autofree char *path = g_strdup_printf ("/var/lib/tb710fu-face-password/%u", (guint) getuid ());
+  g_autofree char *contents = NULL;
+  guint selected = 0;
+
+  if (!self->face_password_row)
+    return;
+
+  if (g_file_get_contents (path, &contents, NULL, NULL))
+    {
+      g_strdelimit (contents, "\n", '\0');
+      for (guint i = 1; password_modes[i]; i++)
+        if (g_str_equal (contents, password_modes[i]))
+          selected = i;
+    }
+  g_signal_handler_block (self->face_password_row, self->face_password_changed);
+  adw_combo_row_set_selected (self->face_password_row, selected);
+  g_signal_handler_unblock (self->face_password_row, self->face_password_changed);
+}
