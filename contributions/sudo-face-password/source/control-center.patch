 {
   gboolean enabled = face_unlock_enabled ();
+
+  refresh_password_mode (self);

   adw_preferences_row_set_title (ADW_PREFERENCES_ROW (self->face_toggle_row),
                                  enabled ? face_text ("Turn Off Face Unlock", "关闭人脸解锁")
@@ -335,10 +365,12 @@
