-                              &error, "/usr/bin/pkexec", FACE_SETTINGS_ADMIN, action, NULL);
+  const char *helper = g_strv_contains (password_modes, action) ? FACE_PASSWORD_ADMIN : FACE_SETTINGS_ADMIN;
+  process = g_subprocess_new (G_SUBPROCESS_FLAGS_STDOUT_PIPE | G_SUBPROCESS_FLAGS_STDERR_MERGE,
+                              &error, "/usr/bin/pkexec", helper, action, NULL);
   if (!process)
