#!/bin/sh
# TB710FU / snap1: two built-in AMICs through WCD9395 and TX SoundWire Pin1.
set -eu
# A rollback to the speaker-only DT must remain bootable.
[ -d /proc/device-tree/sound/wcd-capture-dai-link ] || exit 0
ready=0
for attempt in $(seq 1 90); do
    if amixer -q -c LenovoTB710FU sget 'ADC1 MUX' >/dev/null 2>&1; then
        ready=1
        break
    fi
    sleep 1
done
[ "$ready" = 1 ] || { echo 'TB710FU microphone: ALSA card unavailable' >&2; exit 1; }
set_mix() { amixer -q -c LenovoTB710FU sset "$@"; }
set_mix 'ADC1 MUX' CH1_AMIC1
set_mix ADC1 12 on
set_mix ADC1_MIXER on
set_mix 'TX0 MODE' ADC_LP
set_mix 'TX DEC0 MUX' SWR_MIC
set_mix 'TX SMIC MUX0' SWR_MIC0
set_mix TX_DEC0 96
set_mix 'TX_AIF1_CAP Mixer DEC0' on
set_mix 'ADC2 MUX' CH2_AMIC3
set_mix ADC2 12 on
set_mix ADC2_MIXER on
set_mix 'TX1 MODE' ADC_LP
set_mix 'TX DEC1 MUX' SWR_MIC
set_mix 'TX SMIC MUX1' SWR_MIC1
set_mix TX_DEC1 96
set_mix 'TX_AIF1_CAP Mixer DEC1' on
set_mix 'MultiMedia3 Mixer TX_CODEC_DMA_TX_3' on
echo 'TB710FU internal microphones: AMIC1/AMIC3 -> DEC0/DEC1 ready'
