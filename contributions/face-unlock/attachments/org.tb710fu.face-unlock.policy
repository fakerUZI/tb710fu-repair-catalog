<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
    "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.tb710fu.face-unlock.manage">
    <description>Manage face unlock</description>
    <description xml:lang="zh_CN">管理人脸解锁</description>
    <message>Administrator authentication is required to manage face unlock</message>
    <message xml:lang="zh_CN">管理人脸解锁需要管理员认证</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/tb710fu-face-unlock/settings-admin</annotate>
  </action>
</policyconfig>
